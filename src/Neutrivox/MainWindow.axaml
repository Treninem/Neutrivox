<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Neutrivox.MainWindow"
        Width="1280" Height="800" MinWidth="1000" MinHeight="650" Title="Neutrivox">
  <Grid RowDefinitions="Auto,*" Background="#0B1020">
    <Border Padding="20,14" Background="#111A33" BorderBrush="#263456" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="19" Background="#19B9D1"><TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White"/></Border>
          <StackPanel Spacing="0" VerticalAlignment="Center"><TextBlock Text="NEUTRIVOX" FontWeight="Bold" FontSize="20" Foreground="White"/><TextBlock x:Name="SubtitleText" Text="Среда промышленной автоматизации" FontSize="11" Foreground="#9FB0D0"/></StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><Button x:Name="LanguageButton" Click="LanguageButton_OnClick">RU</Button><Button x:Name="NewProjectButton" Click="NewProjectButton_OnClick">Новый проект</Button></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="230,*,290" Margin="16">
      <Border Background="#111A33" CornerRadius="12" Padding="12" Margin="0,0,12,0"><StackPanel Spacing="8">
        <TextBlock x:Name="NavigationTitle" Text="Навигация" FontWeight="SemiBold" Foreground="#9FB0D0" Margin="8,6"/>
        <Button x:Name="ProjectsNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Projects">📁  Проекты</Button>
        <Button x:Name="DevicesNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Devices">▣  Оборудование</Button>
        <Button x:Name="SchemeNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Scheme">⌁  Схема</Button>
        <Button x:Name="LogicNav" HorizontalContentAlignment="Left" Click="LogicNavigationButton_OnClick" Tag="Logic">⚡  Логика</Button>
        <Button x:Name="InputsNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Inputs">⇄  Входы и выходы</Button>
        <Button x:Name="CheckNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Check">✓  Проверка</Button>
        <Button x:Name="SettingsNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Settings">⚙  Настройки</Button>
      </StackPanel></Border>
      <Border Grid.Column="1" Background="#111A33" CornerRadius="12" Padding="24"><Grid RowDefinitions="Auto,Auto,*">
        <TextBlock x:Name="PageTitle" Text="Добро пожаловать в Neutrivox" FontSize="28" FontWeight="Bold" Foreground="White"/>
        <TextBlock x:Name="PageDescription" Grid.Row="1" Margin="0,8,0,18" Foreground="#AAB8D6" FontSize="15" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2"><StackPanel x:Name="PageContent" Spacing="12"/></ScrollViewer>
      </Grid></Border>
      <Border Grid.Column="2" Background="#111A33" CornerRadius="12" Padding="18" Margin="12,0,0,0"><StackPanel Spacing="12">
        <TextBlock x:Name="ProjectPanelTitle" Text="Текущий проект" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="ProjectNameText" Text="Проект не создан" Foreground="#AAB8D6" TextWrapping="Wrap"/>
        <TextBlock x:Name="DeviceCountText" Text="Оборудование: 0" Foreground="#AAB8D6"/>
        <Separator/>
        <TextBlock x:Name="QuickStartTitle" Text="Быстрый старт" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock x:Name="QuickStartText" Text="1. Создайте проект&#x0a;2. Добавьте оборудование&#x0a;3. Настройте входы и выходы&#x0a;4. Создайте логику&#x0a;5. Проверьте конфигурацию" TextWrapping="Wrap" Foreground="#AAB8D6"/>
      </StackPanel></Border>
    </Grid>
  </Grid>
</Window>