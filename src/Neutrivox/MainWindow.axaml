<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Neutrivox.MainWindow"
        Width="1280" Height="800"
        MinWidth="1000" MinHeight="650"
        Title="Neutrivox">
  <Grid RowDefinitions="Auto,*" Background="#0B1020">
    <Border Grid.Row="0" Padding="20,14" Background="#111A33" BorderBrush="#263456" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border Width="38" Height="38" CornerRadius="19" Background="#19B9D1">
            <TextBlock Text="N" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="White" />
          </Border>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="NEUTRIVOX" FontWeight="Bold" FontSize="20" Foreground="White" />
            <TextBlock x:Name="SubtitleText" Text="Среда промышленной автоматизации" FontSize="11" Foreground="#9FB0D0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="LanguageButton" Click="LanguageButton_OnClick">RU</Button>
          <Button x:Name="NewProjectButton" Click="NewProjectButton_OnClick">Новый проект</Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="240,*,300" Margin="16">
      <Border Background="#111A33" CornerRadius="12" Padding="12" Margin="0,0,12,0">
        <StackPanel Spacing="8">
          <TextBlock x:Name="NavigationTitle" Text="Навигация" FontWeight="SemiBold" FontSize="13" Foreground="#9FB0D0" Margin="8,6" />
          <Button x:Name="ProjectsNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Projects">📁  Проекты</Button>
          <Button x:Name="DevicesNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Devices">▣  Оборудование</Button>
          <Button x:Name="SchemeNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Scheme">⌁  Схема</Button>
          <Button x:Name="InputsNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Inputs">⇄  Входы и выходы</Button>
          <Button x:Name="CheckNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Check">✓  Проверка</Button>
          <Button x:Name="SettingsNav" HorizontalContentAlignment="Left" Click="NavigationButton_OnClick" Tag="Settings">⚙  Настройки</Button>
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="#111A33" CornerRadius="12" Padding="28">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock x:Name="PageTitle" Text="Добро пожаловать в Neutrivox" FontSize="28" FontWeight="Bold" Foreground="White" />
          <TextBlock x:Name="PageDescription" Grid.Row="1" Margin="0,8,0,24" Text="Создайте проект и начните настройку оборудования." Foreground="#AAB8D6" FontSize="15" />
          <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="*,*" ColumnSpacing="16" RowSpacing="16">
            <Button x:Name="CreateCard" Click="NewProjectButton_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <StackPanel Margin="12" Spacing="8"><TextBlock x:Name="CreateCardTitle" Text="Создать проект" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CreateCardText" Text="Начните новую схему автоматизации" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
            </Button>
            <Button Grid.Column="1" Click="DevicesButton_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <StackPanel Margin="12" Spacing="8"><TextBlock x:Name="DevicesCardTitle" Text="Добавить оборудование" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DevicesCardText" Text="Выберите контроллер или модуль" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
            </Button>
            <Button Grid.Row="1" Click="CheckButton_OnClick" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
              <StackPanel Margin="12" Spacing="8"><TextBlock x:Name="CheckCardTitle" Text="Проверить проект" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CheckCardText" Text="Найдите ошибки до подключения оборудования" TextWrapping="Wrap" Opacity="0.7"/></StackPanel>
            </Button>
            <Border Grid.Row="1" Grid.Column="1" Background="#0D152B" CornerRadius="10" Padding="20">
              <StackPanel VerticalAlignment="Center" Spacing="8"><TextBlock x:Name="StatusTitle" Text="Статус" FontSize="18" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="StatusText" Text="Программа готова к созданию первого проекта." TextWrapping="Wrap" Foreground="#AAB8D6"/></StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" Background="#111A33" CornerRadius="12" Padding="18" Margin="12,0,0,0">
        <StackPanel Spacing="12">
          <TextBlock x:Name="ProjectPanelTitle" Text="Текущий проект" FontSize="16" FontWeight="SemiBold" Foreground="White" />
          <TextBlock x:Name="ProjectNameText" Text="Проект не создан" Foreground="#AAB8D6" />
          <Separator />
          <TextBlock x:Name="QuickStartTitle" Text="Быстрый старт" FontWeight="SemiBold" Foreground="White" />
          <TextBlock x:Name="QuickStartText" Text="1. Создайте проект&#x0a;2. Добавьте оборудование&#x0a;3. Настройте входы и выходы&#x0a;4. Проверьте конфигурацию" TextWrapping="Wrap" Foreground="#AAB8D6" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
